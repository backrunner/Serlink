{
  "name": "@serlink/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svedocs dev",
    "build": "svedocs build",
    "preview": "svedocs preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:docs": "svedocs check --translations --strict",
    "check:deploy": "wrangler deploy --dry-run --outdir .svedocs/worker",
    "test": "playwright test",
    "deploy": "pnpm check && pnpm check:docs && pnpm build && wrangler deploy --no-autoconfig",
    "preview:static": "wrangler dev --local --ip 127.0.0.1 --port 4189"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "svedocs": "0.2.2",
    "svelte": "5.57.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "svedocs-cli": "0.2.2",
    "svelte-check": "4.7.6",
    "typescript": "^6.0.3",
    "wrangler": "4.144.0"
  },
  "packageManager": "pnpm@12.3.4",
  "description": "The official Serlink product website and documentation."
}
