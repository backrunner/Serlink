{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serlink-site",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "build", "html_handling": "force-trailing-slash", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "serlink.alkinum.com", "custom_domain": true }],
  "observability": { "enabled": false }
}
